{
  "manifest_version": 3,
  "name": "Chromnotes",
  "description": "A sleek new tab note-taking experience with theme persistence.",
  "version": "1.1.2",
  "permissions": ["storage"],
  "icons": {
    "16": "images/icon.png",
    "48": "images/icon.png",
    "128": "images/icon.png"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
